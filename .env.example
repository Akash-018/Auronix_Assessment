# Local development — SQLite needs no server and is the default:
DATABASE_URL=sqlite:///./pixeltest.db
# Local Postgres via docker-compose:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixeltest
# Deployed — a managed Postgres whose free tier does not expire (see README):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/pixeltest?sslmode=require
JWT_SECRET=super-secret-pixeltest-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
STORAGE_PROVIDER=local
STORAGE_BUCKET=pixeltest-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
INITIAL_ADMIN_EMAIL=admin@pixeltest.com
INITIAL_ADMIN_PASSWORD=AdminPassword123!
